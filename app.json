{
  "expo": {
    "name": "anything",
    "slug": "anything",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "anything",
    "userInterfaceStyle": "automatic",
    "locales": {
      "en": {
        "ios": {
          "NSCameraUsageDescription": "Anything uses your camera to add images to your library.",
          "NSMicrophoneUsageDescription": "Allow Anything to access your microphone to record audio.",
          "NSPhotoLibraryAddUsageDescription": "Anything needs access to save images to your camera roll.",
          "NSPhotoLibraryUsageDescription": "Anything accesses your photos so you can add images to your library."
        }
      },
      "pt-BR": {
        "ios": {
          "NSCameraUsageDescription": "O Anything usa sua câmera para adicionar imagens à biblioteca.",
          "NSMicrophoneUsageDescription": "Permita que o Anything acesse o microfone para gravar áudio.",
          "NSPhotoLibraryAddUsageDescription": "O Anything precisa acessar as fotos para salvar imagens no rolo da câmera.",
          "NSPhotoLibraryUsageDescription": "O Anything acessa suas fotos para que você possa adicionar imagens à biblioteca."
        }
      }
    },
    "ios": {
      "appleTeamId": "J7V84PT2S6",
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.diegoeiras.anything",
      "requireFullScreen": true,
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.diegoeiras.anything"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.DOWNLOAD_WITHOUT_NOTIFICATION",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.diegoeiras.anything"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-file-system",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you select images for your library."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsText": true,
              "supportsWebUrlWithMaxCount": 1,
              "supportsWebPageWithMaxCount": 1,
              "supportsImageWithMaxCount": 1,
              "supportsFileWithMaxCount": 1
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/*",
              "image/*",
              "application/pdf"
            ]
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "The app needs access to save images to your camera roll.",
          "savePhotosPermission": "The app needs access to save images to your camera roll."
        }
      ],
      "expo-video",
      "llama.rn",
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf",
      "@bacons/apple-targets",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Anything to access your microphone to record audio.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "pt-BR"],
            "android": ["en", "pt-BR"]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "expo-sharing-extension",
                  "bundleIdentifier": "com.diegoeiras.anything.expo-sharing-extension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.diegoeiras.anything"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.diegoeiras.anything.widget",
                  "targetName": "AnythingControls",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.diegoeiras.anything"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "6d8626bb-4d97-4110-bfe7-c8f0e88bebe8"
      }
    },
    "owner": "eiras5g"
  }
}
